{
  "name": "tema-mppa-next-template",
  "version": "1.0.0",
  "private": true,
  "description": "Template visual reutilizável para aplicações Next.js, com shell configurável e tema Marvel.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:template": "node scripts/verify-template.mjs",
    "check": "npm run verify:template && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@tanstack/react-query": "5.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.70.0",
    "next": "16.3.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
